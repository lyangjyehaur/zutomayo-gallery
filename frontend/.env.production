# ==========================================
# ZUTOMAYO MV Gallery - 前端生產環境環境變數
# ==========================================
#
# 注意：
# 這份檔案會在 `vite build` 的 production mode 下被讀取，
# 用來覆蓋本機 `.env`，避免把開發環境設定打包進線上 dist。

# 後端 API 伺服器位址
# 生產環境採用同網域相對路徑，由反向代理轉送到後端
VITE_API_ROOT=/api
VITE_API_ORIGIN=https://zutomayo.art
VITE_DEV_API_ORIGIN=http://localhost:5010

# Imgproxy / 靜態資源 / 套件來源網域
VITE_IMGPROXY_ORIGIN=https://img.zutomayo.art
VITE_ASSETS_ORIGIN=https://assets.zutomayo.art
VITE_UNPKG_ORIGIN=https://unpkg.com

# 留言板伺服器位址
# 線上正式留言服務
VITE_WALINE_SERVER_URL=https://comments.zutomayo.art/
VITE_WALINE_EMOJI_ORIGIN=https://unpkg.com
VITE_WALINE_EMOJI_FASTLY_ORIGIN=https://fastly.jsdelivr.net/npm
VITE_WALINE_AVATAR_ORIGIN=https://gravatar.com/avatar
VITE_WALINE_AVATAR_MIRROR_ORIGIN=https://cravatar.cn/avatar
VITE_WALINE_AVATAR_SOURCE_ORIGINS=https://gravatar.com,https://www.gravatar.com,https://seccdn.alipay.com,https://sdn.geekzu.org

# 影音嵌入來源
VITE_YOUTUBE_EMBED_ORIGIN=https://www.youtube.com/embed
VITE_BILIBILI_EMBED_ORIGIN=https://player.bilibili.com/player.html

# 圖片代理與加速服務
# 海外/大圖與圖片處理所使用的正式服務
VITE_TWITTER_IMAGE_SOURCE_HOST=https://pbs.twimg.com
VITE_TWITTER_VIDEO_SOURCE_HOST=https://video.twimg.com
VITE_TWITTER_PROXY_PATH=/ti
VITE_TWITTER_VIDEO_PROXY_PATH=/tv
VITE_YOUTUBE_SOURCE_HOSTS=i.ytimg.com,img.youtube.com,youtube.com
VITE_YOUTUBE_PROXY_PATH=/yi

# R2 自訂網域
# 供 Apple Music 與其他媒體資源在正式環境讀取
VITE_R2_DOMAIN=https://r2.dan.tw

# Umami 統計與 Session Replay
# 正式站的 commons.js / recorder.js 共用此基底設定
VITE_UMAMI_SECONDARY_WEBSITE_ID=76cef12d-6b0a-4b5c-882b-36d87912e4f5
VITE_UMAMI_SECONDARY_HOST_URL=https://zutomayo.art/commons
VITE_UMAMI_SECONDARY_BASE_SCRIPT=/commons
VITE_UMAMI_TRACKER_SCRIPT_NAME=commons.js
VITE_UMAMI_RECORDER_SCRIPT_NAME=telemetry.js

# 外部頁面與社交平台網址
VITE_X_ORIGIN=https://x.com
VITE_INSTAGRAM_ORIGIN=https://instagram.com
VITE_TIKTOK_ORIGIN=https://tiktok.com
VITE_UNAVATAR_X_ORIGIN=https://unavatar.io/x
VITE_GRAVATAR_ORIGIN=https://www.gravatar.com/avatar
VITE_APPLE_MUSIC_ORIGIN=https://music.apple.com
VITE_ITUNES_API_ORIGIN=https://itunes.apple.com
VITE_PROJECT_REPOSITORY_URL=https://github.com/lyangjyehaur/zutomayo-gallery
VITE_PROJECT_OWNER_URL=https://dan.tw
VITE_ZUTOMAYO_OFFICIAL_URL=https://zutomayo.net
VITE_BILIBILI_CREATOR_URL=https://space.bilibili.com/531797444
VITE_RIKKA_URL=https://jhenty.cn
VITE_FUSION_PIXEL_FONT_URL=https://github.com/TakWolf/fusion-pixel-font
VITE_FANCYBOX_URL=https://fancyapps.com/fancybox/
VITE_GEMINI_URL=https://gemini.google.com/
VITE_PIXEL_ICON_LIBRARY_URL=https://pixeliconlibrary.com/
VITE_CREATIVE_COMMONS_URL=https://creativecommons.org/licenses/by/4.0/
VITE_OPEN_FONT_LICENSE_URL=https://openfontlicense.org/
VITE_NEOBRUTALISM_URL=https://www.neobrutalism.dev/
VITE_DEMO_CD_IMAGE_URL=https://is1-ssl.mzstatic.com/image/thumb/Music113/v4/b7/fe/4c/b7fe4cb4-fb88-578c-d58d-f650043ff298/19UMGIM82675.rgb.jpg/1000x1000.jpg
VITE_BARK_API_BASE_URL=https://api.day.app
VITE_RSSHUB_BASE_URL=https://rss.zutomayo.art

# Copy this file to deploy-local.conf and fill in the deployment-specific values.
# deploy-local.conf is gitignored; host addresses and runtime topology do not belong in scripts.

# SSH target. SSH_TARGET may be an alias from ~/.ssh/config. If omitted, set SERVER_USER and SERVER_IP.
SSH_TARGET=""
SERVER_USER=""
SERVER_IP=""
SERVER_PORT=""

# Fail stalled transfers instead of waiting forever. Values are seconds except the retry count.
SSH_CONNECT_TIMEOUT="15"
SSH_KEEPALIVE_INTERVAL="10"
SSH_KEEPALIVE_COUNT_MAX="3"
SSH_CONNECTION_ATTEMPTS="3"

# Remote project and static-site paths
REMOTE_PROJECT_PATH=""
REMOTE_DEPLOY_PATH=""
REMOTE_REVIEW_DEPLOY_PATH=""
REMOTE_BACKUP_PATH=""

# Optional legacy migration page deployment
REMOTE_LEGACY_DEPLOY_PATH=""
LEGACY_SITE_TARGET_URL=""
LEGACY_REDIRECT_CONF=""
OPENRESTY_CONTAINER_NAME=""

# Backend Docker runtime
BACKEND_CONTAINER_NAME=""
DOCKER_NETWORK=""
NODE_IMAGE=""
BACKEND_HEALTH_ORIGIN=""
BACKEND_PORT=""
BACKEND_RESTART_POLICY="unless-stopped"

# RSSHub maintenance
RSSHUB_COMPOSE_FILE=""
RSSHUB_SERVICE_NAME=""
TWITTER_COOKIE_DOMAIN=""
